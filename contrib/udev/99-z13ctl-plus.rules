# 99-z13ctl-plus.rules — z13ctl-plus ASUS ROG Flow Z13 device access
#
# Device nodes (HID RGB devices, Armoury Crate button) get group users here.
# sysfs attributes (profile, battery limit, firmware attributes, fans, PPT,
# camera, CPU power, opt-in ryzen_smu) are granted by "z13ctl-plus setup
# --perms-only", run on each relevant device or module add event and by
# z13ctl-plus-perms.service at boot, using the group saved in
# /etc/z13ctl-plus/setup.conf.
#
# To use a different group, run: sudo z13ctl-plus setup --group=<group>
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18c6", MODE="0660", GROUP="users"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1a30", MODE="0660", GROUP="users"
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Asus WMI hotkeys", MODE="0660", GROUP="users"
ACTION=="add", SUBSYSTEM=="platform-profile", RUN+="/usr/bin/z13ctl-plus setup --perms-only"
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="asus-nb-wmi", RUN+="/usr/bin/z13ctl-plus setup --perms-only"
ACTION=="add", SUBSYSTEM=="power_supply", KERNEL=="BAT*", RUN+="/usr/bin/z13ctl-plus setup --perms-only"
ACTION=="add", SUBSYSTEM=="firmware-attributes", KERNEL=="asus-armoury", RUN+="/usr/bin/z13ctl-plus setup --perms-only"
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="asus_custom_fan_curve|asus", RUN+="/usr/bin/z13ctl-plus setup --perms-only"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{removable}=="fixed", ATTR{product}=="*[Ww]ebcam*|*[Cc]amera*", RUN+="/usr/bin/z13ctl-plus setup --perms-only"
ACTION=="add", SUBSYSTEM=="module", KERNEL=="ryzen_smu|amd_pstate|asus_armoury|asus_nb_wmi", RUN+="/usr/bin/z13ctl-plus setup --perms-only"
